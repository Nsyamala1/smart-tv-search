# What this process serves: search (default, for Railway), tv (at home), all (local dev)
MODE=search
PORT=3001

# --- search mode ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here
# Long random string. The phone app must send the same value.
APP_TOKEN=
# Optional limits
SEARCH_PER_MINUTE=10
DAILY_SEARCH_LIMIT=300

# --- tv mode ---
# Long random string. The phone app must send the same value.
TV_TOKEN=

# Optional: report API usage to the portfolio site's CRM (/admin/crm/keys).
# CRM_URL=https://web-production-34dfd.up.railway.app
# CRM_TOKEN=<same value as METRICS_TOKEN on the portfolio site>
# CRM_KEY_ANTHROPIC=anthropic-main   # the name you gave the key on the keys page
# CRM_KEY_TMDB=tmdb
